{
  "manifestVersion": 5,
  "id": "clipforage.premiere.spike",
  "name": "ClipForage (spike)",
  "version": "0.0.1",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "clipforagePanel",
      "label": {
        "default": "ClipForage"
      },
      "minimumSize": { "width": 300, "height": 300 },
      "preferredDockedSize": { "width": 320, "height": 480 },
      "preferredFloatingSize": { "width": 400, "height": 520 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": ["http://127.0.0.1:8765", "http://localhost:8765"]
    },
    "localFileSystem": "request"
  }
}
